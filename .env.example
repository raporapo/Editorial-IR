# Copy this file to .env and paste your Gemini API key after the "=".
# That one line runs description, judgement and search on Gemini.
# `oea` reads .env from the directory you run it in; .env is never committed.
# Get a key at https://aistudio.google.com/apikey
OEA_GEMINI_API_KEY=

# Optional: transcription and on-screen text run on this machine, free. Install
# the worker once (pip install -e 'services/perception[asr,ocr,audio]'), then:
# OEA_PERCEPTION=python

# Optional: transcription from a server instead of the worker's Whisper, such as
# Phonon-2 (English only, fast on a CPU): pip install fermion-research, then
# `phonon serve --port 8010`, and set editing_goal.language: en in context.yaml.
# OEA_TRANSCRIBE_BASE_URL=http://localhost:8010/v1
# OEA_TRANSCRIBE_MODEL=phonon-2

# Optional: pin other models (defaults are chosen for cost; see docs/models.md).
# OEA_GEMINI_MODEL=gemini-3.8-flash            # descriptions and `oea agent`
# OEA_GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite # judgement, called for every event
# OEA_GEMINI_EMBED_MODEL=gemini-embedding-001  # search
