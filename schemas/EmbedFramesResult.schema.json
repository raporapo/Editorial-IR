{
  "$id": "https://editorial-ir.dev/schemas/EmbedFramesResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "$ref": "#/$defs/__schema0"
    },
    "dim": {
      "$ref": "#/$defs/__schema1"
    },
    "frames": {
      "$ref": "#/$defs/__schema2"
    }
  },
  "required": [
    "dim"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": [
        "string",
        "null"
      ]
    },
    "__schema1": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp_ms": {
            "$ref": "#/$defs/Milliseconds"
          },
          "vector": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "labels": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sharpness": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnitScore"
              },
              {
                "type": "null"
              }
            ]
          },
          "exposure": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnitScore"
              },
              {
                "type": "null"
              }
            ]
          },
          "motion": {
            "anyOf": [
              {
                "$ref": "#/$defs/UnitScore"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "timestamp_ms",
          "vector"
        ],
        "additionalProperties": false
      }
    },
    "Milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Integer milliseconds. Media time is always integer ms, never float seconds."
    },
    "UnitScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
