{
  "$id": "https://editorial-ir.dev/schemas/Conflict.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/cflId"
    },
    "path": {
      "$ref": "#/$defs/__schema0"
    },
    "user_value": {
      "$ref": "#/$defs/__schema1"
    },
    "observed_value": {
      "$ref": "#/$defs/__schema2"
    },
    "inferred_value": {
      "$ref": "#/$defs/__schema3"
    },
    "resolved_with": {
      "$ref": "#/$defs/Provenance"
    },
    "note": {
      "$ref": "#/$defs/__schema4"
    },
    "detected_at": {
      "$ref": "#/$defs/__schema5"
    }
  },
  "required": [
    "id",
    "path",
    "resolved_with",
    "detected_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "cflId": {
      "type": "string",
      "description": "A recorded disagreement between sources."
    },
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {},
    "__schema2": {},
    "__schema3": {},
    "Provenance": {
      "type": "string",
      "enum": [
        "observed",
        "inferred",
        "user_provided",
        "skill_derived",
        "agent_derived",
        "nle_observed"
      ]
    },
    "__schema4": {
      "type": "string"
    },
    "__schema5": {
      "type": "string"
    }
  }
}
