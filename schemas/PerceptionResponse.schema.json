{
  "$id": "https://editorial-ir.dev/schemas/PerceptionResponse.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/__schema0"
    },
    {
      "$ref": "#/$defs/__schema1"
    }
  ],
  "title": "PerceptionResponse",
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "v": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "op": {
          "type": "string"
        },
        "result": {}
      },
      "required": [
        "v",
        "id",
        "ok",
        "op",
        "result"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "v": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean",
          "const": false
        },
        "op": {},
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/PerceptionErrorCode"
            },
            "message": {
              "type": "string"
            },
            "details": {}
          },
          "required": [
            "code",
            "message",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "v",
        "id",
        "ok",
        "op",
        "error"
      ],
      "additionalProperties": false
    },
    "PerceptionErrorCode": {
      "type": "string",
      "enum": [
        "bad_request",
        "unsupported_op",
        "missing_dependency",
        "media_error",
        "model_error",
        "out_of_memory",
        "cancelled",
        "internal"
      ]
    }
  }
}
