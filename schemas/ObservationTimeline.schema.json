{
  "$id": "https://editorial-ir.dev/schemas/ObservationTimeline.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "$ref": "#/$defs/__schema0"
    },
    "pipeline_version": {
      "$ref": "#/$defs/__schema1"
    },
    "generated_at": {
      "$ref": "#/$defs/__schema2"
    },
    "utterances": {
      "$ref": "#/$defs/__schema3"
    },
    "shots": {
      "$ref": "#/$defs/__schema9"
    },
    "audio_events": {
      "$ref": "#/$defs/__schema12"
    },
    "ocr": {
      "$ref": "#/$defs/__schema15"
    },
    "frame_features": {
      "$ref": "#/$defs/__schema19"
    },
    "audio_profiles": {
      "$ref": "#/$defs/__schema26"
    }
  },
  "required": [
    "project_id",
    "pipeline_version",
    "generated_at",
    "utterances",
    "shots",
    "audio_events",
    "ocr",
    "frame_features",
    "audio_profiles"
  ],
  "additionalProperties": false,
  "title": "ObservationTimeline",
  "$defs": {
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/Utterance"
      }
    },
    "Utterance": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/uttId"
        },
        "asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "start_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "end_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "speaker_id": {
          "$ref": "#/$defs/__schema4"
        },
        "text": {
          "$ref": "#/$defs/__schema5"
        },
        "language": {
          "$ref": "#/$defs/__schema6"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "words": {
          "$ref": "#/$defs/__schema7"
        },
        "model_run_id": {
          "$ref": "#/$defs/__schema8"
        }
      },
      "required": [
        "id",
        "asset_id",
        "start_ms",
        "end_ms",
        "text",
        "confidence"
      ],
      "additionalProperties": false
    },
    "uttId": {
      "type": "string",
      "description": "One transcribed utterance."
    },
    "assetId": {
      "type": "string",
      "description": "A registered source file."
    },
    "Milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Integer milliseconds. Media time is always integer ms, never float seconds."
    },
    "__schema4": {
      "type": "string"
    },
    "__schema5": {
      "type": "string"
    },
    "__schema6": {
      "type": "string"
    },
    "Confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in [0,1]. 1 means certain, 0 means no support at all."
    },
    "__schema7": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_ms": {
            "$ref": "#/$defs/Milliseconds"
          },
          "end_ms": {
            "$ref": "#/$defs/Milliseconds"
          },
          "text": {
            "type": "string"
          },
          "confidence": {
            "$ref": "#/$defs/Confidence"
          }
        },
        "required": [
          "start_ms",
          "end_ms",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "__schema8": {
      "$ref": "#/$defs/runId"
    },
    "runId": {
      "type": "string",
      "description": "One execution of a model or rule-based stage."
    },
    "__schema9": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/Shot"
      }
    },
    "Shot": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/shotId"
        },
        "asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "start_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "end_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "representative_frame_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "change_score": {
          "$ref": "#/$defs/__schema10"
        },
        "model_run_id": {
          "$ref": "#/$defs/__schema11"
        }
      },
      "required": [
        "id",
        "asset_id",
        "start_ms",
        "end_ms",
        "representative_frame_ms"
      ],
      "additionalProperties": false
    },
    "shotId": {
      "type": "string",
      "description": "A camera shot within one asset."
    },
    "__schema10": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema11": {
      "$ref": "#/$defs/runId"
    },
    "__schema12": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/AudioEvent"
      }
    },
    "AudioEvent": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/aevId"
        },
        "asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "start_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "end_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "event_type": {
          "$ref": "#/$defs/AudioEventType"
        },
        "raw_label": {
          "$ref": "#/$defs/__schema13"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "model_run_id": {
          "$ref": "#/$defs/__schema14"
        }
      },
      "required": [
        "id",
        "asset_id",
        "start_ms",
        "end_ms",
        "event_type",
        "confidence"
      ],
      "additionalProperties": false
    },
    "aevId": {
      "type": "string",
      "description": "One detected audio event."
    },
    "AudioEventType": {
      "type": "string",
      "enum": [
        "speech",
        "silence",
        "music",
        "laughter",
        "applause",
        "cheering",
        "crowd",
        "traffic",
        "nature",
        "noise",
        "other"
      ]
    },
    "__schema13": {
      "type": "string"
    },
    "__schema14": {
      "$ref": "#/$defs/runId"
    },
    "__schema15": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/OcrObservation"
      }
    },
    "OcrObservation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ocrId"
        },
        "asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "start_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "end_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "text": {
          "$ref": "#/$defs/__schema16"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "bbox": {
          "$ref": "#/$defs/__schema17"
        },
        "model_run_id": {
          "$ref": "#/$defs/__schema18"
        }
      },
      "required": [
        "id",
        "asset_id",
        "start_ms",
        "end_ms",
        "text",
        "confidence"
      ],
      "additionalProperties": false
    },
    "ocrId": {
      "type": "string",
      "description": "One on-screen text observation."
    },
    "__schema16": {
      "type": "string",
      "minLength": 1
    },
    "__schema17": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "__schema18": {
      "$ref": "#/$defs/runId"
    },
    "__schema19": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/FrameFeature"
      }
    },
    "FrameFeature": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/frmId"
        },
        "asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "timestamp_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "labels": {
          "$ref": "#/$defs/__schema20"
        },
        "sharpness": {
          "$ref": "#/$defs/__schema21"
        },
        "exposure": {
          "$ref": "#/$defs/__schema22"
        },
        "motion": {
          "$ref": "#/$defs/__schema23"
        },
        "embedding_ref": {
          "$ref": "#/$defs/__schema24"
        },
        "model_run_id": {
          "$ref": "#/$defs/__schema25"
        }
      },
      "required": [
        "id",
        "asset_id",
        "timestamp_ms",
        "labels"
      ],
      "additionalProperties": false
    },
    "frmId": {
      "type": "string",
      "description": "One sampled frame."
    },
    "__schema20": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema21": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema22": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema23": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema24": {
      "type": "string"
    },
    "__schema25": {
      "$ref": "#/$defs/runId"
    },
    "__schema26": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/AudioProfile"
      }
    },
    "AudioProfile": {
      "type": "object",
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "hop_ms": {
          "$ref": "#/$defs/__schema27"
        },
        "rms_db": {
          "$ref": "#/$defs/__schema28"
        },
        "speech_prob": {
          "$ref": "#/$defs/__schema29"
        },
        "model_run_id": {
          "$ref": "#/$defs/__schema30"
        }
      },
      "required": [
        "asset_id",
        "hop_ms",
        "rms_db"
      ],
      "additionalProperties": false
    },
    "__schema27": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema28": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "__schema29": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "__schema30": {
      "$ref": "#/$defs/runId"
    }
  }
}
