{
  "$id": "https://editorial-ir.dev/schemas/EmbeddingSet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "project_id": {
      "$ref": "#/$defs/__schema0"
    },
    "generated_at": {
      "$ref": "#/$defs/__schema1"
    },
    "records": {
      "$ref": "#/$defs/__schema2"
    }
  },
  "required": [
    "project_id",
    "generated_at",
    "records"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/EmbeddingRecord"
      }
    },
    "EmbeddingRecord": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema3"
        },
        "owner_id": {
          "$ref": "#/$defs/__schema4"
        },
        "kind": {
          "$ref": "#/$defs/EmbeddingKind"
        },
        "dim": {
          "$ref": "#/$defs/__schema5"
        },
        "vector": {
          "$ref": "#/$defs/__schema6"
        },
        "model_run_id": {
          "$ref": "#/$defs/__schema7"
        }
      },
      "required": [
        "id",
        "owner_id",
        "kind",
        "dim",
        "vector"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "minLength": 1
    },
    "__schema4": {
      "type": "string",
      "minLength": 1
    },
    "EmbeddingKind": {
      "type": "string",
      "enum": [
        "visual",
        "speech",
        "event",
        "context",
        "mood",
        "audio"
      ]
    },
    "__schema5": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "__schema7": {
      "$ref": "#/$defs/runId"
    },
    "runId": {
      "type": "string",
      "description": "One execution of a model or rule-based stage."
    }
  }
}
