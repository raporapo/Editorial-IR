{
  "$id": "https://editorial-ir.dev/schemas/ChoiceResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "selected": {
      "$ref": "#/$defs/__schema0"
    },
    "probabilities": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "selected",
    "probabilities"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Probability"
      }
    },
    "Probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Probability in [0,1]. Unlike Confidence this is a belief about the world, not about the model."
    }
  }
}
