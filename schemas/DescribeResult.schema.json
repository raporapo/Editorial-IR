{
  "$id": "https://editorial-ir.dev/schemas/DescribeResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "$ref": "#/$defs/__schema0"
    },
    "description": {
      "$ref": "#/$defs/__schema1"
    },
    "event_type": {
      "$ref": "#/$defs/__schema2"
    },
    "title": {
      "$ref": "#/$defs/__schema3"
    },
    "entities": {
      "$ref": "#/$defs/__schema4"
    },
    "affect": {
      "$ref": "#/$defs/__schema5"
    },
    "confidence": {
      "$ref": "#/$defs/__schema7"
    },
    "input_tokens": {
      "$ref": "#/$defs/__schema8"
    },
    "output_tokens": {
      "$ref": "#/$defs/__schema9"
    }
  },
  "required": [
    "model",
    "description",
    "event_type",
    "title",
    "entities",
    "affect",
    "confidence",
    "input_tokens",
    "output_tokens"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {},
    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "default": "",
      "type": "string"
    },
    "__schema3": {},
    "__schema4": {
      "type": "object",
      "properties": {
        "people": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "places": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "objects": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "topics": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "people",
        "places",
        "objects",
        "topics"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "default": {},
      "$ref": "#/$defs/Affect"
    },
    "Affect": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema6"
      },
      "additionalProperties": {
        "$ref": "#/$defs/UnitScore"
      },
      "description": "Named affect intensities in [0,1], e.g. {\"excitement\":0.88,\"happiness\":0.83}."
    },
    "__schema6": {
      "type": "string"
    },
    "UnitScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema7": {
      "default": 0.5,
      "$ref": "#/$defs/Confidence"
    },
    "Confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in [0,1]. 1 means certain, 0 means no support at all."
    },
    "__schema8": {},
    "__schema9": {}
  }
}
