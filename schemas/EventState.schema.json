{
  "$id": "https://editorial-ir.dev/schemas/EventState.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "#/$defs/__schema0"
    },
    "duration_ms": {
      "$ref": "#/$defs/Milliseconds"
    },
    "relative_position": {
      "$ref": "#/$defs/UnitScore"
    },
    "observed": {
      "$ref": "#/$defs/__schema1"
    },
    "semantic": {
      "$ref": "#/$defs/__schema2"
    },
    "previous_event": {
      "$ref": "#/$defs/__schema4"
    },
    "next_event": {
      "$ref": "#/$defs/__schema5"
    },
    "user_context": {
      "$ref": "#/$defs/__schema6"
    },
    "max_similarity_to_others": {
      "$ref": "#/$defs/__schema7"
    }
  },
  "required": [
    "event_id",
    "duration_ms",
    "relative_position",
    "observed",
    "semantic",
    "user_context"
  ],
  "additionalProperties": false,
  "title": "EventState",
  "$defs": {
    "__schema0": {
      "type": "string"
    },
    "Milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Integer milliseconds. Media time is always integer ms, never float seconds."
    },
    "UnitScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "speech": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_labels": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ocr": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audio": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shot_count": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "speech_ratio": {
          "default": 0,
          "$ref": "#/$defs/UnitScore"
        },
        "silence_ratio": {
          "default": 0,
          "$ref": "#/$defs/UnitScore"
        },
        "technical_quality": {
          "$ref": "#/$defs/UnitScore"
        }
      },
      "required": [
        "speech",
        "visual_labels",
        "ocr",
        "audio",
        "shot_count",
        "speech_ratio",
        "silence_ratio"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "event_type": {
          "default": "",
          "type": "string"
        },
        "entities": {
          "type": "object",
          "properties": {
            "people": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "places": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "topics": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "people",
            "places",
            "topics"
          ],
          "additionalProperties": false
        },
        "affect": {
          "default": {},
          "$ref": "#/$defs/Affect"
        }
      },
      "required": [
        "description",
        "event_type",
        "entities",
        "affect"
      ],
      "additionalProperties": false
    },
    "Affect": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema3"
      },
      "additionalProperties": {
        "$ref": "#/$defs/UnitScore"
      },
      "description": "Named affect intensities in [0,1], e.g. {\"excitement\":0.88,\"happiness\":0.83}."
    },
    "__schema3": {
      "type": "string"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "event_type"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "event_type": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "event_type"
      ],
      "additionalProperties": false
    },
    "__schema6": {
      "type": "object",
      "properties": {
        "occasion": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "tone": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "essential": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "tone",
        "notes",
        "essential"
      ],
      "additionalProperties": false
    },
    "__schema7": {
      "$ref": "#/$defs/UnitScore"
    }
  }
}
