      "type": "string",
      "enum": [
        "local",
        "remote_api",
        "unknown"
      ]
    },
    "__schema55": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "__schema56": {
      "default": 0,
      "type": "number",
      "minimum": 0
    },
    "__schema57": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema58": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema59": {
      "$ref": "#/$defs/Milliseconds"
    },
    "__schema60": {
      "default": false,
      "type": "boolean"
    },
    "PlanStats": {
      "type": "object",
      "properties": {
        "operation_count": {
          "$ref": "#/$defs/__schema61"
        },
        "total_duration_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "duration_error_ms": {
          "$ref": "#/$defs/__schema62"
        },
        "compression_ratio": {
          "$ref": "#/$defs/UnitScore"
        },
        "events_selected": {
          "$ref": "#/$defs/__schema63"
        },
        "events_available": {
          "$ref": "#/$defs/__schema64"
        },
        "mean_importance": {
          "$ref": "#/$defs/UnitScore"
