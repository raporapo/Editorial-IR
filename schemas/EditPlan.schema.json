    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "SequenceSpec": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/__schema3"
        },
        "target_duration_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "tolerance_ms": {
          "$ref": "#/$defs/__schema4"
        },
        "width": {
          "$ref": "#/$defs/__schema5"
        },
        "height": {
          "$ref": "#/$defs/__schema6"
        },
        "frame_rate": {
          "$ref": "#/$defs/__schema7"
        },
        "frame_rate_num": {
          "$ref": "#/$defs/__schema8"
        },
        "frame_rate_den": {
          "$ref": "#/$defs/__schema9"
        },
        "sample_rate": {
          "$ref": "#/$defs/__schema10"
        }
      },
      "required": [
        "name",
        "target_duration_ms"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "string",
      "minLength": 1
    },
    "Milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Integer milliseconds. Media time is always integer ms, never float seconds."
    },
    "__schema4": {
      "default": 0,
      "$ref": "#/$defs/Milliseconds"
    },
    "__schema5": {
      "default": 1920,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema6": {
      "default": 1080,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema7": {
      "default": 30,
      "type": "number",
      "exclusiveMinimum": 0
    },
    "__schema8": {
      "default": 30,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema9": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema10": {
      "default": 48000,
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema11": {
