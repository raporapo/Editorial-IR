        "operation_count",
        "total_duration_ms",
        "duration_error_ms",
        "compression_ratio",
        "events_selected",
        "events_available",
        "mean_importance",
        "mean_continuity"
      ],
      "additionalProperties": false
    },
    "__schema61": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema62": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "UnitScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema63": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
