        "locked": {
          "$ref": "#/$defs/__schema22"
        }
      },
      "additionalProperties": false
    },
    "__schema20": {
      "$ref": "#/$defs/Milliseconds"
    },
    "__schema21": {
      "$ref": "#/$defs/Milliseconds"
    },
    "__schema22": {
      "default": false,
      "type": "boolean"
