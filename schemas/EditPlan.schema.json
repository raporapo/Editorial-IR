      "type": "string",
      "description": "One operation within an EditPlan."
    },
    "assetId": {
      "type": "string",
      "description": "A registered source file."
    },
    "__schema12": {
      "$ref": "#/$defs/evtId"
    },
    "evtId": {
      "type": "string",
      "description": "A semantic event: one thing that happened."
    },
    "__schema13": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema14": {
      "$ref": "#/$defs/NarrativeRole"
    },
    "NarrativeRole": {
      "type": "string",
      "enum": [
        "setup",
        "context",
        "build_up",
        "transition",
        "payoff",
        "climax",
        "reaction",
        "resolution",
        "ending",
        "filler"
      ],
      "description": "The structural job an event does in the finished piece."
    },
    "__schema15": {
      "default": 1,
      "type": "number",
      "exclusiveMinimum": 0
