      "required": [
        "type",
        "asset_id"
      ],
      "additionalProperties": false
    },
    "TextOperation": {
      "type": "object",
      "properties": {
        "operation_id": {
          "$ref": "#/$defs/opId"
        },
        "timeline_start_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "timeline_end_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "text": {
          "$ref": "#/$defs/__schema29"
        },
        "kind": {
          "$ref": "#/$defs/__schema30"
