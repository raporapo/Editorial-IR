        "source_asset_id": {
          "$ref": "#/$defs/assetId"
        },
        "event_id": {
          "$ref": "#/$defs/__schema12"
        },
        "source_in_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "source_out_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "timeline_start_ms": {
          "$ref": "#/$defs/Milliseconds"
        },
        "track": {
          "$ref": "#/$defs/__schema13"
        },
        "role": {
          "$ref": "#/$defs/__schema14"
        },
        "speed": {
          "$ref": "#/$defs/__schema15"
        },
        "transition_in": {
          "$ref": "#/$defs/__schema16"
        },
        "transition_out": {
          "$ref": "#/$defs/__schema18"
        },
        "constraints": {
          "$ref": "#/$defs/__schema19"
        },
        "use_source_audio": {
