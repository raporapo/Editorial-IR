        "middle": {
          "$ref": "#/$defs/__schema40"
        },
        "ending": {
          "$ref": "#/$defs/__schema41"
        },
        "tone": {
          "$ref": "#/$defs/__schema42"
        }
      },
      "additionalProperties": false
    },
    "__schema39": {
      "type": "string"
    },
    "__schema40": {
      "type": "string"
    },
    "__schema41": {
      "type": "string"
    },
    "__schema42": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema43": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/PlanRationale"
      }
    },
    "PlanRationale": {
      "type": "object",
      "properties": {
        "event_id": {
          "$ref": "#/$defs/evtId"
        },
        "operation_id": {
          "$ref": "#/$defs/__schema44"
        },
        "decision": {
          "$ref": "#/$defs/__schema45"
        },
        "reason": {
          "$ref": "#/$defs/__schema46"
        },
        "score": {
          "$ref": "#/$defs/__schema47"
        },
        "skill_rule_ids": {
          "$ref": "#/$defs/__schema48"
        },
        "tags": {
          "$ref": "#/$defs/__schema49"
        }
      },
      "required": [
        "event_id",
        "decision",
        "reason"
      ],
      "additionalProperties": false
    },
    "__schema44": {
      "$ref": "#/$defs/opId"
    },
    "__schema45": {
      "type": "string",
      "enum": [
        "selected",
        "trimmed",
        "dropped",
        "locked",
        "excluded"
      ]
    },
    "__schema46": {
      "type": "string"
    },
    "__schema47": {
      "type": "number"
    },
    "__schema48": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema49": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__schema50": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/ModelRun"
      }
    },
    "ModelRun": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/runId"
        },
        "stage": {
          "$ref": "#/$defs/PipelineStage"
        },
        "backend": {
          "$ref": "#/$defs/__schema51"
        },
        "model": {
          "$ref": "#/$defs/__schema52"
        },
        "model_version": {
          "$ref": "#/$defs/__schema53"
        },
        "locality": {
          "$ref": "#/$defs/__schema54"
        },
        "parameters": {
          "$ref": "#/$defs/__schema55"
