          "$ref": "#/$defs/__schema35"
        },
        "kind": {
          "$ref": "#/$defs/__schema36"
        },
        "event_id": {
          "$ref": "#/$defs/__schema37"
        }
      },
      "required": [
        "timeline_ms",
        "name"
      ],
      "additionalProperties": false
