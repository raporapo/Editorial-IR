    },
    "skill": {
      "$ref": "#/$defs/__schema2"
    },
    "sequence": {
      "$ref": "#/$defs/SequenceSpec"
    },
    "tracks": {
      "$ref": "#/$defs/__schema11"
    },
    "markers": {
      "$ref": "#/$defs/__schema34"
    },
    "intent": {
      "$ref": "#/$defs/__schema38"
    },
    "rationale": {
      "$ref": "#/$defs/__schema43"
    },
    "model_runs": {
      "$ref": "#/$defs/__schema50"
    },
    "stats": {
      "$ref": "#/$defs/PlanStats"
    }
