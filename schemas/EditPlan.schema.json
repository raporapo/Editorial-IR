        "input_tokens": {
          "$ref": "#/$defs/__schema57"
        },
        "output_tokens": {
          "$ref": "#/$defs/__schema58"
        },
        "latency_ms": {
          "$ref": "#/$defs/__schema59"
        },
        "media_left_device": {
          "$ref": "#/$defs/__schema60"
        },
        "created_at": {
          "$ref": "#/$defs/Iso8601"
        }
      },
      "required": [
        "id",
        "stage",
        "backend",
        "created_at"
      ],
      "additionalProperties": false
    },
    "runId": {
      "type": "string",
      "description": "One execution of a model or rule-based stage."
    },
    "PipelineStage": {
      "type": "string",
      "enum": [
        "ingest",
        "speech",
        "visual",
        "audio",
        "motion",
        "ocr",
        "shot_detection",
        "segmentation",
        "context",
        "decision",
        "embedding",
        "planning",
        "review"
      ]
    },
    "__schema51": {
      "type": "string",
      "minLength": 1
    },
    "__schema52": {
      "type": "string"
    },
    "__schema53": {
      "type": "string"
    },
    "__schema54": {
