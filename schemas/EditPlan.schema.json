        "gain_db": {
          "default": 0,
          "type": "number"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "__schema28": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "external"
