    "__schema17": {
      "default": 0,
      "$ref": "#/$defs/Milliseconds"
    },
    "__schema18": {
      "$ref": "#/$defs/Transition"
    },
    "__schema19": {
      "$ref": "#/$defs/OperationConstraints"
    },
