{
  "$id": "https://editorial-ir.dev/schemas/OcrResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "$ref": "#/$defs/__schema0"
    },
    "observations": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "model",
    "observations"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {},
    "__schema1": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_ms": {
            "$ref": "#/$defs/Milliseconds"
          },
          "end_ms": {
            "$ref": "#/$defs/Milliseconds"
          },
          "text": {
            "type": "string"
          },
          "confidence": {
            "default": 0.5,
            "$ref": "#/$defs/Confidence"
          },
          "bbox": {}
        },
        "required": [
          "start_ms",
          "end_ms",
          "text",
          "confidence",
          "bbox"
        ],
        "additionalProperties": false
      }
    },
    "Milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Integer milliseconds. Media time is always integer ms, never float seconds."
    },
    "Confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in [0,1]. 1 means certain, 0 means no support at all."
    }
  }
}
