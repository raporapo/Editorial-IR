{
  "$id": "https://editorial-ir.dev/schemas/AnalyzeAudioResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "$ref": "#/$defs/__schema0"
    },
    "hop_ms": {
      "$ref": "#/$defs/__schema1"
    },
    "rms_db": {
      "$ref": "#/$defs/__schema2"
    },
    "speech_prob": {
      "$ref": "#/$defs/__schema3"
    },
    "events": {
      "$ref": "#/$defs/__schema4"
    }
  },
  "required": [
    "hop_ms"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": [
        "string",
        "null"
      ]
    },
    "__schema1": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "__schema2": {
      "default": [],
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "__schema3": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnitScore"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "UnitScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "__schema4": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_ms": {
            "$ref": "#/$defs/Milliseconds"
          },
          "end_ms": {
            "$ref": "#/$defs/Milliseconds"
          },
          "event_type": {
            "$ref": "#/$defs/AudioEventType"
          },
          "raw_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "default": 0.5,
            "$ref": "#/$defs/Confidence"
          }
        },
        "required": [
          "start_ms",
          "end_ms",
          "event_type"
        ],
        "additionalProperties": false
      }
    },
    "Milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Integer milliseconds. Media time is always integer ms, never float seconds."
    },
    "AudioEventType": {
      "type": "string",
      "enum": [
        "speech",
        "silence",
        "music",
        "laughter",
        "applause",
        "cheering",
        "crowd",
        "traffic",
        "nature",
        "noise",
        "other"
      ]
    },
    "Confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in [0,1]. 1 means certain, 0 means no support at all."
    }
  }
}
