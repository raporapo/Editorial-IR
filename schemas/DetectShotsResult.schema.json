{
  "$id": "https://editorial-ir.dev/schemas/DetectShotsResult.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model": {
      "$ref": "#/$defs/__schema0"
    },
    "shots": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "model",
    "shots"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {},
    "__schema1": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_ms": {
            "$ref": "#/$defs/Milliseconds"
          },
          "end_ms": {
            "$ref": "#/$defs/Milliseconds"
          },
          "representative_frame_ms": {
            "$ref": "#/$defs/Milliseconds"
          },
          "change_score": {}
        },
        "required": [
          "start_ms",
          "end_ms",
          "representative_frame_ms",
          "change_score"
        ],
        "additionalProperties": false
      }
    },
    "Milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Integer milliseconds. Media time is always integer ms, never float seconds."
    }
  }
}
