{
  "$id": "https://editorial-ir.dev/schemas/AssetPlacement.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "asset_id": {
      "$ref": "#/$defs/assetId"
    },
    "offset_ms": {
      "$ref": "#/$defs/Milliseconds"
    },
    "order": {
      "$ref": "#/$defs/__schema0"
    },
    "ordered_by": {
      "$ref": "#/$defs/__schema1"
    }
  },
  "required": [
    "asset_id",
    "offset_ms",
    "order",
    "ordered_by"
  ],
  "additionalProperties": false,
  "$defs": {
    "assetId": {
      "type": "string",
      "description": "A registered source file."
    },
    "Milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Integer milliseconds. Media time is always integer ms, never float seconds."
    },
    "__schema0": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema1": {
      "type": "string",
      "enum": [
        "creation_time",
        "file_name",
        "explicit"
      ]
    }
  }
}
