{
  "$id": "https://editorial-ir.dev/schemas/ModelRun.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/runId"
    },
    "stage": {
      "$ref": "#/$defs/PipelineStage"
    },
    "backend": {
      "$ref": "#/$defs/__schema0"
    },
    "model": {
      "$ref": "#/$defs/__schema1"
    },
    "model_version": {
      "$ref": "#/$defs/__schema2"
    },
    "locality": {
      "$ref": "#/$defs/__schema3"
    },
    "parameters": {
      "$ref": "#/$defs/__schema4"
    },
    "cost_usd": {
      "$ref": "#/$defs/__schema5"
    },
    "input_tokens": {
      "$ref": "#/$defs/__schema6"
    },
    "output_tokens": {
      "$ref": "#/$defs/__schema7"
    },
    "latency_ms": {
      "$ref": "#/$defs/__schema8"
    },
    "media_left_device": {
      "$ref": "#/$defs/__schema9"
    },
    "created_at": {
      "$ref": "#/$defs/Iso8601"
    }
  },
  "required": [
    "id",
    "stage",
    "backend",
    "locality",
    "parameters",
    "cost_usd",
    "media_left_device",
    "created_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "runId": {
      "type": "string",
      "description": "One execution of a model or rule-based stage."
    },
    "PipelineStage": {
      "type": "string",
      "enum": [
        "ingest",
        "speech",
        "visual",
        "audio",
        "ocr",
        "shot_detection",
        "segmentation",
        "context",
        "decision",
        "embedding",
        "planning",
        "review"
      ]
    },
    "__schema0": {
      "type": "string",
      "minLength": 1
    },
    "__schema1": {
      "type": "string"
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "default": "unknown",
      "$ref": "#/$defs/ExecutionLocality"
    },
    "ExecutionLocality": {
      "type": "string",
      "enum": [
        "local",
        "remote_api",
        "unknown"
      ]
    },
    "__schema4": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "__schema5": {
      "default": 0,
      "type": "number",
      "minimum": 0
    },
    "__schema6": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema7": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema8": {
      "$ref": "#/$defs/Milliseconds"
    },
    "Milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Integer milliseconds. Media time is always integer ms, never float seconds."
    },
    "__schema9": {
      "default": false,
      "type": "boolean"
    },
    "Iso8601": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 timestamp, always UTC with a trailing Z."
    }
  }
}
