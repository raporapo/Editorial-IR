{
  "name": "@editorial-ir/cli",
  "version": "0.1.0",
  "description": "oea — the Editorial IR command line interface.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "oea": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
