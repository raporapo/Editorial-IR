{
  "name": "@editorial-ir/cli",
  "version": "0.1.0",
  "description": "oea — the Editorial IR command line interface.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "oea": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "node scripts/bundle-example.mjs"
  },
  "files": [
    "dist",
    "example",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@editorial-ir/contracts": "workspace:*",
    "@editorial-ir/core": "workspace:*",
    "@editorial-ir/agent": "workspace:*",
    "@editorial-ir/adapters": "workspace:*",
    "@editorial-ir/skills": "workspace:*",
    "@editorial-ir/decision": "workspace:*",
    "@editorial-ir/perception": "workspace:*",
    "@editorial-ir/index": "workspace:*",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raporapo/Editorial-IR.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/raporapo/Editorial-IR#readme",
  "bugs": {
    "url": "https://github.com/raporapo/Editorial-IR/issues"
  },
  "keywords": [
    "video",
    "editing",
    "editorial",
    "opentimelineio",
    "premiere",
    "aviutl",
    "ffmpeg"
  ]
}
