{
  "note": "ffprobe output measured on ffmpeg 6.1 (trimmed to the fields the probe reads), and what each runtime must make of it. Both the TypeScript and the Python probe are tested against this file.",
  "cases": [
    {
      "name": "a MOV with a drop-frame timecode track",
      "ffprobe": {
        "format": {
          "format_name": "mov,mp4,m4a,3gp,3g2,mj2",
          "duration": "2.002000"
        },
        "streams": [
          {
            "index": 0,
            "codec_name": "h264",
            "codec_type": "video",
            "width": 320,
            "height": 240,
            "r_frame_rate": "30000/1001",
            "avg_frame_rate": "30000/1001",
            "duration": "2.002000",
            "nb_frames": "60",
            "tags": {
              "timecode": "01:00:00;00"
            }
          },
          {
            "index": 1,
            "codec_name": "aac",
            "codec_type": "audio",
            "sample_rate": "48000",
            "channels": 1,
            "r_frame_rate": "0/0",
            "avg_frame_rate": "0/0",
            "duration": "2.000000",
            "nb_frames": "95"
          },
          {
            "index": 2,
            "codec_type": "data",
            "r_frame_rate": "0/0",
            "avg_frame_rate": "30000/1001",
            "duration": "2.002000",
            "nb_frames": "1",
            "tags": {
              "timecode": "01:00:00;00"
            }
          }
        ]
      },
      "expected": {
        "duration_ms": 2002,
        "start_timecode": "01:00:00;00"
      }
    },
    {
      "name": "an MKV, whose tags are in capitals",
      "ffprobe": {
        "format": {
          "format_name": "matroska,webm",
          "duration": "2.000000",
          "tags": {
            "TIMECODE": "03:00:00:00"
          }
        },
        "streams": [
          {
            "index": 0,
            "codec_name": "h264",
            "codec_type": "video",
            "width": 320,
            "height": 240,
            "r_frame_rate": "25/1",
            "avg_frame_rate": "25/1",
            "tags": {
              "DURATION": "00:00:02.000000000"
            }
          }
        ]
      },
      "expected": {
        "duration_ms": 2000,
        "start_timecode": "03:00:00:00"
      }
    },
    {
      "name": "an MXF, which keeps its timecode on the container",
      "ffprobe": {
        "format": {
          "format_name": "mxf",
          "duration": "2.000000",
          "tags": {
            "company_name": "FFmpeg",
            "timecode": "10:00:00:00"
          }
        },
        "streams": [
          {
            "index": 0,
            "codec_name": "mpeg2video",
            "codec_type": "video",
            "width": 320,
            "height": 240,
            "r_frame_rate": "25/1",
            "avg_frame_rate": "25/1",
            "duration": "2.000000"
          },
          {
            "index": 1,
            "codec_name": "pcm_s16le",
            "codec_type": "audio",
            "sample_rate": "48000",
            "channels": 1,
            "r_frame_rate": "0/0",
            "avg_frame_rate": "0/0",
            "duration": "2.000000"
          }
        ]
      },
      "expected": {
        "duration_ms": 2000,
        "start_timecode": "10:00:00:00"
      }
    },
